{
  "name": "@mantis/cli",
  "version": "0.1.6",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "mantis": "./dist/index.js"
  },
  "engines": {
    "node": ">=25.8.0"
  },
  "scripts": {
    "dev": "node scripts/gen-version.mjs && tsx src/index.ts",
    "build": "node scripts/gen-version.mjs && tsc",
    "build:bin": "bash scripts/build-bin.sh",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
