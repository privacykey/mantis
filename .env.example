# --- Required ---
DATABASE_URL=postgres://mantis:mantis@localhost:5432/mantis
PUBLIC_BASE_URL=http://localhost:3000

# --- Optional ---
# Path prefix for the public trigger endpoint. Defaults to "/c".
# Use something neutral if you want stealthier URLs, e.g. "/r" or "/track".
MANTIS_PUBLIC_PATH=/c

# Optional bootstrap API key. If set on first boot AND no api_keys exist yet,
# the value is registered as the first key. Useful for IaC / one-shot deploys.
# Generate one with:  node -e "console.log('mantis_live_' + require('crypto').randomBytes(24).toString('base64url'))"
# BOOTSTRAP_API_KEY=

# SMTP URL for email notifications. Format: smtp://user:pass@host:port
# SMTP_URL=
# SMTP_FROM="Mantis <mantis@example.com>"

# Log level (trace|debug|info|warn|error). Default: info
# LOG_LEVEL=info

# Host-based access control (only enforced when at least one of the two
# lists below is set; otherwise everything is allowed on any Host, which is
# fine for a single-host deployment).
#
# Hostnames that should expose only public mantis routes. Useful for split
# Tailscale deployments where PUBLIC_BASE_URL points at a public Funnel
# hostname while the dashboard lives on a private Serve hostname.
# PUBLIC_ONLY_HOSTS=mantis-public.<your-tailnet>.ts.net
#
# Hostnames that may serve the full management surface (dashboard + /api/*).
# When PUBLIC_ONLY_HOSTS is set and DASHBOARD_HOSTS is unset, any Host that
# isn't in PUBLIC_ONLY_HOSTS is *also* treated as public-only — that's the
# fail-closed behavior introduced to close a Host-header spoof bypass.
# Explicitly list your dashboard hostname(s) here to opt out.
# DASHBOARD_HOSTS=mantis-private.<your-tailnet>.ts.net
#
# By default the public-only host allows /c/*, /status/*, and /api/wallet/*.
# Opt into these only when you intentionally need them on the public hostname.
# PUBLIC_ONLY_ALLOW_HEALTH=0
# PUBLIC_ONLY_ALLOW_INBOX=0

# Trust client-IP headers (cf-connecting-ip, x-vercel-forwarded-for, x-real-ip,
# x-forwarded-for). Set to 1 ONLY when this app sits behind a proxy that strips
# and re-injects these headers (Cloudflare, cloudflared tunnel, Tailscale
# Funnel, Vercel, nginx, etc.). Direct internet exposure with this set to 1
# allows IP spoofing in your forensic log. Auto-enabled under Vercel and in
# non-production. In production with no proxy, leave unset — IPs will be null
# rather than spoofable.
# TRUST_PROXY_HEADERS=1

# Capture/storage safety caps. Defaults are intentionally above Node's normal
# 16 KiB combined request-header limit, so ordinary accepted traffic should not
# truncate. Raise only if you also raise your HTTP server/proxy header limits.
# MANTIS_MAX_STORED_REQUEST_FIELD_CHARS=16384
# MANTIS_MAX_STORED_HEADER_SNAPSHOT_CHARS=65536
#
# Hit dedupe storage: record the first hit in a dedupe window, record up to N
# duplicate rows for context, then suppress further duplicate rows while still
# returning the normal trigger response. Set to 0 to store only the first hit.
# MANTIS_DUPLICATE_LOG_LIMIT=10

# Allow webhook destinations to resolve to RFC1918 / loopback / link-local /
# cloud-metadata addresses. Default: refuse private addresses (SSRF guard).
# Set to 1 if your webhook target is on the same LAN as this server, e.g. an
# internal Mattermost / Gotify / ntfy. Verbose: 169.254.169.254 (AWS/GCP/Azure
# metadata) is also covered by the private-address check.
# ALLOW_PRIVATE_WEBHOOKS=0

# Built-in webhook capture at /inbox (no external webhook service needed for
# testing). The inbox is unauthenticated and stores arbitrary captured bodies
# in memory — leave OFF in production. Set to 1 only on dev / local boxes.
# ENABLE_DEV_INBOX=1

# Notification worker — runs by default on non-Vercel deploys. Set to 0 to disable
# (and instead use the /api/cron/notifications endpoint via an external scheduler).
# RUN_NOTIFY_WORKER=1

# --- Retention --------------------------------------------------------------
# Optional row-level cleanup. Sweep runs once an hour inside the notify worker
# (or via /api/cron/notifications on Vercel). Unset = retain forever.
#
# Delete hits (and cascade their notifications) older than N days:
# MANTIS_HIT_RETENTION_DAYS=90
#
# Delete settled (succeeded/failed/aborted) notifications older than N days,
# even if their hit is still alive — keeps the queue table from growing:
# MANTIS_NOTIFICATION_RETENTION_DAYS=30
#
# Delete audit_events older than N days. The audit table is append-only at
# the DB layer (a trigger blocks UPDATE/DELETE); the retention sweep uses a
# privileged path the trigger allows. Default longer than hits because this
# is the trail you'd consult after a compromise.
# MANTIS_AUDIT_RETENTION_DAYS=365
#
# Delete terminated sessions (revoked or naturally expired) older than N
# days. Active sessions are never affected — getSessionApiKey enforces the
# row's expires_at on every lookup. This is GC for the sessions table.
# MANTIS_SESSION_RETENTION_DAYS=7

# Shared secret for /api/cron/notifications. REQUIRED to enable that endpoint.
# Without it, /api/cron/notifications returns 401 — the worker mode (default
# for non-Vercel deployments) still runs fine without it. Vercel Cron injects
# the value automatically if you set CRON_SECRET in project env.
# CRON_SECRET=

# --- Docker compose: host port binding ------------------------------------
# Default: bind mantis to 127.0.0.1 only (localhost-reachable). When using a
# tunnel sidecar (tailscale / cloudflared), the tunnel reaches mantis via the
# docker network — the published port stays localhost-only.
# Set to 0.0.0.0 to expose to LAN when running without a tunnel.
# MANTIS_BIND_HOST=127.0.0.1
# MANTIS_HOST_PORT=3000

# --- Tunnel: Tailscale ----------------------------------------------------
# Enable with: docker compose --profile tailscale up
# Generate at https://login.tailscale.com/admin/settings/keys
# Recommend: ephemeral + reusable for compose lifecycle, with tag.
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# TS_HOSTNAME=mantis
# TS_EXTRA_ARGS=--advertise-tags=tag:mantis
#
# Split public/private mode:
# Enable with: docker compose --profile tailscale-split up
# TS_PRIVATE_HOSTNAME=mantis-private
# TS_PUBLIC_HOSTNAME=mantis-public
# PUBLIC_BASE_URL=https://mantis-public.<your-tailnet>.ts.net
# PUBLIC_ONLY_HOSTS=mantis-public.<your-tailnet>.ts.net
# DASHBOARD_HOSTS=mantis-private.<your-tailnet>.ts.net

# --- Tunnel: Cloudflare ---------------------------------------------------
# Enable with: docker compose --profile cloudflared up
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels.
# Set the public hostname's service to: http://mantis:3000
# CLOUDFLARE_TUNNEL_TOKEN=ey...

# --- Apple Wallet (.pkpass) -----------------------------------------------
# Optional. When all five required vars below are set, mantis can mint signed
# .pkpass passes (download format = apple-wallet) and serve Wallet's callback
# endpoints under /api/wallet/. Fires hits with X-Mantis-Source: wallet-installed
# / wallet-uninstalled / wallet-fetched when Wallet calls back.
#
# Requires an Apple Developer Program account ($99/yr) to obtain a Pass Type
# ID certificate. See:
#   https://developer.apple.com/account/resources/identifiers/list/passTypeId
# Export the cert from Keychain Access as a .p12 (note the password you set).
#
# APPLE_PASS_CERT_PATH=/run/secrets/apple-pass.p12
# APPLE_PASS_CERT_PASS=<the password you set when exporting the .p12>
# APPLE_PASS_TEAM_ID=ABCDE12345                  # 10-char Apple Team ID
# APPLE_PASS_TYPE_ID=pass.com.yourdomain.mantis  # the Pass Type ID you registered
# APPLE_PASS_AUTH_SECRET=<random 32+ char string — used to HMAC-derive per-pass auth tokens>
# Optional WWDR intermediate cert (download from Apple PKI). If unset, passkit-generator
# falls back to whatever it ships with — may not work on newer iOS versions.
# APPLE_PASS_WWDR_PATH=/run/secrets/apple-wwdr.pem
# Optional custom icon/logo PNGs. If unset, mantis uses a solid-yellow default.
# APPLE_PASS_ICON_PATH=/var/lib/mantis/wallet-icon.png    # 58×58 PNG
# APPLE_PASS_LOGO_PATH=/var/lib/mantis/wallet-logo.png    # 160×50 PNG
# APPLE_PASS_ORG_NAME=Mantis                              # shown on the pass
#
# --- APNs pass-update push (optional) ---
# When you change a key's memo, mantis can push an empty APNs notification to
# every device that has the pass installed; Wallet then re-fetches the pass.
# Requires a separate APNs Auth Key (.p8) generated at:
#   https://developer.apple.com/account/resources/authkeys/list
# This is NOT the same file as the Pass Type ID cert above.
# APPLE_PASS_APNS_KEY_PATH=/run/secrets/apns-auth-key.p8
# APPLE_PASS_APNS_KEY_ID=ABCDE12345                       # 10-char key ID from Apple
# Use sandbox (api.development.push.apple.com) instead of prod:
# APPLE_PASS_APNS_SANDBOX=0
