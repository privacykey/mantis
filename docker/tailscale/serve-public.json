{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/c": {
          "Proxy": "http://mantis:3000/c"
        },
        "/status": {
          "Proxy": "http://mantis:3000/status"
        },
        "/api/wallet": {
          "Proxy": "http://mantis:3000/api/wallet"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}
