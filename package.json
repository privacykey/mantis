{
  "name": "mantis",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm --prefix cli run typecheck && npm --prefix mantis-edge run typecheck && npm --prefix iot-helper run check",
    "build:cli-bin": "bash cli/scripts/build-bin.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:hooks": "bash scripts/install-hooks.sh",
    "bench": "npm run bench:cli",
    "bench:all": "npm run bench:cli && npm run bench:edge && npm run bench:server",
    "bench:cli": "npm --prefix cli run build && node bench/cli/bench.js --all",
    "bench:edge": "npm --prefix bench/edge run bench:all",
    "bench:server": "node bench/server/bench.js --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "passkit-generator": "^3.5.7",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
